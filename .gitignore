# 忽略本地大数据目录与派生文件
datasets/
sources/
*.zip
*.tar
data*.jsonl

# 忽略Python虚拟环境
.venv/

# 忽略本地环境变量文件
.env
.env.*
.env.local
.env.secret
!.env.example

# 忽略VSCode的配置
.vscode/

# 忽略kilocode的配置
.kilocode/
# 忽略claude的配置
.claude/
# 忽略垃圾箱
.trash/

# 忽略其他常见文件
*.pyc
__pycache__/

# 忽略个人辅助脚本
*.sh
!scripts/*.sh

# 忽略 docs 目录下除 documentation.md 与 timeline.md 外的所有内容
docs/**
!docs/documentation.md
!docs/timeline.md

# 忽略web打包产物与BMAD生成内容
web-bundles/
.bmad*

# 忽略本地IDE/模式配置
.roomodes/
.roomodes

# 忽略爬虫输出
web_scraper/scraped_images/
web_scraper/agri_sites_run.log
tmp/http_8000.log
tmp/http_8000.pid
web_scraper/pest_review_manifest.js
web_scraper/site_configs/wikimedia_only.json
pest_review_*.json
.factory/config.json
.DS_Store
*.log
logs/missing_no_json.txt

# 忽略所有备份文件
*.backup
*.backup_*
logs/llm_monitoring_data.json
