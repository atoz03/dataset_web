  {
    "name": "wikimedia_commons",
    "type": "commons",
    "enabled": false,
    "base_url": "https://commons.wikimedia.org/w/api.php",
    "search": {
      "params": {
        "action": "query",
        "format": "json",
        "origin": "*",
        "generator": "search",
